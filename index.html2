<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Cinevault | Video Editor</title>
<meta name="description" content="Cinevault is a video editing studio with 3 years of experience. Long form, short form, motion graphics, podcast, talking head and real estate videos for clients in India and worldwide.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#0a0a0b;--bg2:#121214;--line:rgba(241,236,228,.14);--text:#f1ece4;--muted:#9b968d;--acc:#ff5a36;color-scheme:dark;
  box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0a0a0b;--text:#f1ece4}}
:root[data-theme="dark"]{--bg:#0a0a0b;--text:#f1ece4}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--text);font:400 17px/1.65 Manrope,system-ui,-apple-system,"Segoe UI",sans-serif;overflow-x:hidden}
body::after{content:"";position:fixed;inset:0;pointer-events:none;opacity:.07;z-index:50;background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='2'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>")}
h1,h2,h3{font-family:"Instrument Serif",Georgia,serif;font-weight:400;margin:0;line-height:.95;letter-spacing:-.01em}
em{font-style:italic;color:var(--acc)}
a{color:inherit}
:focus-visible{outline:2px solid var(--acc);outline-offset:4px}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}
header .wrap{display:flex;justify-content:space-between;align-items:center;padding-top:26px;gap:16px}
.brand{font:400 26px "Instrument Serif",serif;text-decoration:none}
.right{display:flex;align-items:center;gap:26px;font-size:14px;color:var(--muted)}
.dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:#46d27a;margin-right:9px;box-shadow:0 0 0 0 rgba(70,210,122,.6);animation:pulse 2.2s infinite}
@keyframes pulse{70%{box-shadow:0 0 0 9px rgba(70,210,122,0)}100%{box-shadow:0 0 0 0 rgba(70,210,122,0)}}
#tc{font-variant-numeric:tabular-nums;letter-spacing:.06em}
.pill{display:inline-block;padding:14px 26px;border-radius:99px;background:var(--text);color:var(--bg);font-weight:700;text-decoration:none;font-size:15px;transition:background .2s,color .2s}
.pill:hover{background:var(--acc);color:#fff}
.link{font-weight:500;text-decoration:underline;text-underline-offset:6px;text-decoration-color:var(--line);transition:text-decoration-color .2s}
.link:hover{text-decoration-color:var(--acc)}

.hero{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center;padding-top:56px;padding-bottom:40px}
h1{font-size:clamp(60px,9.2vw,138px)}
.hero p{max-width:44ch;color:var(--muted);font-size:19px;margin:30px 0 34px}
.cta{display:flex;flex-wrap:wrap;align-items:center;gap:26px}
.wall{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;align-items:start;padding-bottom:84px}
.ph{aspect-ratio:9/16;border-radius:20px;overflow:hidden;border:1px solid var(--line);background:#000;box-shadow:0 30px 60px -30px rgba(0,0,0,.9)}
.ph video{width:100%;height:100%;object-fit:cover;display:block}
.ph:nth-child(1){transform:translateY(40px)}.ph:nth-child(2){transform:translateY(-10px)}.ph:nth-child(3){transform:translateY(84px)}

.mq{border-top:1px solid var(--line);border-bottom:1px solid var(--line);overflow:hidden;white-space:nowrap;padding:18px 0;margin-top:20px}
.mq div{display:inline-block;animation:mq 38s linear infinite;font:italic 30px "Instrument Serif",serif;color:var(--muted)}
.mq span{margin:0 22px;color:var(--text)}
@keyframes mq{to{transform:translateX(-50%)}}

.stats{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--line)}
.stats div{padding:44px 24px 40px 0}
.stats b{display:block;font:400 clamp(54px,7vw,96px) "Instrument Serif",serif;line-height:1}
.stats span{color:var(--muted);font-size:15px}

section{padding-top:120px}
h2{font-size:clamp(44px,6.6vw,92px)}
.sub{color:var(--muted);max-width:50ch;margin:18px 0 0}
.reels{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;margin-top:52px}
.card{all:unset;display:block;cursor:pointer}
.card .frame{position:relative;aspect-ratio:9/16;border-radius:18px;overflow:hidden;background:#000;border:1px solid var(--line);transition:transform .35s,border-color .35s}
.card:hover .frame,.card:focus-visible .frame{transform:translateY(-8px);border-color:var(--acc)}
.card video{width:100%;height:100%;object-fit:contain;display:block}
.card .tag{position:absolute;left:12px;bottom:12px;padding:7px 14px;border-radius:99px;background:rgba(10,10,11,.7);backdrop-filter:blur(8px);font-size:13px;font-weight:500;color:var(--text)}
.meta{display:flex;justify-content:space-between;gap:10px;padding:14px 2px 0;font-size:14px;color:var(--muted)}
.meta b{color:var(--text);font-weight:500}
.note{margin-top:40px;color:var(--muted)}

.rows{list-style:none;margin:56px 0 0;padding:0;border-top:1px solid var(--line)}
.rows li{display:grid;grid-template-columns:70px 1fr 1fr;gap:20px;align-items:baseline;padding:30px 0;border-bottom:1px solid var(--line);transition:padding-left .3s}
.rows li:hover{padding-left:16px}
.rows i{font-style:normal;color:var(--muted);font-size:14px}
.rows h3{font-size:clamp(34px,4.6vw,60px);transition:color .3s}
.rows li:hover h3{color:var(--acc)}
.rows p{margin:0;color:var(--muted)}

.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:28px;margin-top:52px}
.steps div{border-top:1px solid var(--text);padding-top:18px}
.steps h3{font-size:30px;margin-bottom:10px}
.steps p{margin:0;color:var(--muted);font-size:15.5px}
.tools{display:flex;flex-wrap:wrap;gap:12px;margin-top:44px;align-items:center;color:var(--muted)}
.tools span.t{padding:10px 20px;border:1px solid var(--line);border-radius:99px;color:var(--text);font-weight:500}

.contact{padding-bottom:110px}
.mail{display:inline-block;margin:34px 0 36px;font:400 clamp(30px,7.2vw,104px) "Instrument Serif",serif;line-height:1;letter-spacing:-.01em;text-decoration:none;border-bottom:2px solid var(--acc);word-break:break-all;transition:color .25s}
.mail:hover{color:var(--acc)}
footer{border-top:1px solid var(--line);padding:26px 0 36px;color:var(--muted);font-size:14px}
footer .wrap{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px}

#lb{position:fixed;inset:0;z-index:100;background:rgba(5,5,6,.94);display:none;align-items:center;justify-content:center;padding:calc(56px + env(safe-area-inset-top,0px)) 16px calc(20px + env(safe-area-inset-bottom,0px))}
#lb.on{display:flex}
#lb video{max-height:100%;max-width:100%;border-radius:14px;background:#000}
#lbx{position:absolute;top:calc(14px + env(safe-area-inset-top,0px));right:18px;background:none;border:1px solid var(--line);color:var(--text);padding:9px 18px;border-radius:99px;font:500 14px Manrope,sans-serif;cursor:pointer}
#lbx:hover{border-color:var(--acc)}

.js .rv{opacity:0;transform:translateY(28px);transition:opacity .9s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.2,.7,.2,1)}
.js .rv.in{opacity:1;transform:none}
@media (max-width:900px){
  .hero{grid-template-columns:1fr;gap:30px;padding-top:36px}
  .wall{padding-bottom:60px}
  .reels{grid-template-columns:repeat(2,1fr);gap:16px}
  .stats{grid-template-columns:repeat(2,1fr)}
  .steps{grid-template-columns:repeat(2,1fr)}
  .rows li{grid-template-columns:1fr;gap:6px}
  section{padding-top:84px}
  #tc{display:none}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}.mq div,.dot{animation:none}
  .js .rv{opacity:1;transform:none;transition:none}
}
</style>
</head>
<body>
<header>
  <div class="wrap">
    <a class="brand" href="#top">Cinevault</a>
    <div class="right"><span id="tc" aria-hidden="true">00:00:00:00</span><span><i class="dot"></i>Taking new projects</span></div>
  </div>
</header>

<main id="top">
  <div class="wrap hero">
    <div>
      <h1>Edits that <em>hold</em> attention.</h1>
      <div class="cta">
        <a class="pill" href="#work">Watch my reels</a>
        <a class="link" href="mailto:nshv97755@gmail.com">nshv97755@gmail.com</a>
      </div>
    </div>
    <div class="wall" id="wall" aria-label="Preview of my edited reels"></div>
  </div>

  <div class="mq" aria-hidden="true"><div id="mq"></div></div>

  <div class="wrap">
    <div class="stats rv">
      <div><b>3</b><span>years of editing</span></div>
      <div><b>5</b><span>clients worked with</span></div>
      <div><b>1M+</b><span>views on my edits</span></div>
      <div><b>6</b><span>types of video I edit, short to long form</span></div>
    </div>
  </div>

  <section id="work">
    <div class="wrap">
      <h2 class="rv">My <em>work</em></h2>
      <p class="sub rv">Reels I edited. Tap any video to watch it with sound.</p>
      <div class="reels" id="reels"></div>
      <p class="note">More edits on Instagram at <a class="link" href="https://instagram.com/cinevault91" target="_blank" rel="noopener">@cinevault91</a></p>
    </div>
  </section>

  <section id="services">
    <div class="wrap">
      <h2 class="rv">What I <em>edit</em></h2>
      <ul class="rows">
        <li class="rv"><i>01</i><h3>Long form</h3><p>YouTube videos and vlogs with tight pacing, clean cuts, sound cleanup and graphics.</p></li>
        <li class="rv"><i>02</i><h3>Short form</h3><p>Reels, Shorts and TikToks built around a strong hook, fast cuts and captions.</p></li>
        <li class="rv"><i>03</i><h3>Motion graphics</h3><p>Titles, lower thirds and animated captions that match your brand.</p></li>
        <li class="rv"><i>04</i><h3>Talking head</h3><p>Jump cuts, zooms, b-roll and subtitles that keep one speaker interesting.</p></li>
        <li class="rv"><i>05</i><h3>Podcast</h3><p>Full episodes and short clips, ready to post on every platform.</p></li>
        <li class="rv"><i>06</i><h3>Real estate</h3><p>Property tours with smooth transitions, music and clear text overlays.</p></li>
      </ul>
    </div>
  </section>

  <section id="process">
    <div class="wrap">
      <h2 class="rv">How we <em>work</em></h2>
      <div class="steps">
        <div class="rv"><h3>Brief</h3><p>You share the footage and what you want, by Drive or Dropbox link.</p></div>
        <div class="rv"><h3>First cut</h3><p>I send a draft so you can react to something real.</p></div>
        <div class="rv"><h3>Refine</h3><p>You tell me what to change and I update it.</p></div>
        <div class="rv"><h3>Delivery</h3><p>The final file, in the right format for your platform.</p></div>
      </div>
      <div class="tools"><span>Edited in</span><span class="t">DaVinci Resolve</span><span class="t">CapCut PC</span></div>
    </div>
  </section>

  <section id="contact" class="contact">
    <div class="wrap">
      <h2 class="rv">Have a video that needs a <em>great edit?</em></h2>
      <a class="mail" href="mailto:nshv97755@gmail.com">nshv97755@gmail.com</a>
      <div class="cta">
        <a class="pill" href="mailto:nshv97755@gmail.com?subject=Video%20editing%20project">Start a project</a>
        <a class="link" href="https://instagram.com/cinevault91" target="_blank" rel="noopener">Instagram @cinevault91</a>
      </div>
    </div>
  </section>
</main>

<footer><div class="wrap"><span>© 2026 Cinevault</span><span>Video editor, working with clients worldwide</span></div></footer>

<div id="lb" role="dialog" aria-modal="true" aria-label="Video player"><button id="lbx">Close</button><video id="lbv" controls playsinline></video></div>

<script>
document.documentElement.classList.add("js");
var R=[
 {v:"reel1.mp4",p:"reel1.jpg",d:"0:36",t:"Short form edit"},
 {v:"reel2.mp4",p:"reel2.jpg",d:"0:17",t:"Short form edit"},
 {v:"reel3.mp4",p:"reel3.jpg",d:"0:18",t:"Real estate before and after"},
 {v:"reel4.mp4",p:"reel4.jpg",d:"0:25",t:"Short form edit"}
];
var B="media/";
function vid(r){return '<video muted loop playsinline preload="metadata" data-auto poster="'+B+r.p+'" src="'+B+r.v+'"></video>'}
function go(){
document.getElementById("wall").innerHTML=[0,2,1].map(function(i){return '<div class="ph">'+vid(R[i])+'</div>'}).join("");
document.getElementById("reels").innerHTML=R.map(function(r,i){
  return '<div class="rv"><button class="card" data-i="'+i+'" aria-label="Play reel '+(i+1)+' with sound"><div class="frame">'+vid(r)+'<span class="tag">Play with sound</span></div><div class="meta"><b>'+r.t+'</b><span>'+r.d+'</span></div></button></div>'}).join("");
var S=["Long form","Short form","Motion graphics","Talking head","Podcast","Real estate"],m="";
for(var k=0;k<2;k++)S.forEach(function(s){m+=s+'<span>/</span>'});
document.getElementById("mq").innerHTML=m+m;

// autoplay only what is on screen
var vio=new IntersectionObserver(function(es){es.forEach(function(e){var v=e.target;if(e.isIntersecting){var p=v.play();if(p&&p.catch)p.catch(function(){})}else v.pause()})},{threshold:.25});
document.querySelectorAll("video[data-auto]").forEach(function(v){vio.observe(v)});
// reveal on scroll
var rio=new IntersectionObserver(function(es){es.forEach(function(e){if(e.isIntersecting){e.target.classList.add("in");rio.unobserve(e.target)}})},{threshold:.12});
document.querySelectorAll(".rv").forEach(function(el){rio.observe(el)});
}
// files may sit in /media or next to index.html, detect which
var pr=new Image();pr.onload=go;pr.onerror=function(){B="";go()};pr.src=B+R[0].p;
// lightbox
var lb=document.getElementById("lb"),lv=document.getElementById("lbv");
function openLb(i){lv.poster=B+R[i].p;lv.src=B+R[i].v;lv.muted=false;lb.classList.add("on");var p=lv.play();if(p&&p.catch)p.catch(function(){})}
function closeLb(){lv.pause();lv.removeAttribute("src");lv.load();lb.classList.remove("on")}
document.getElementById("reels").addEventListener("click",function(e){var b=e.target.closest(".card");if(b)openLb(+b.dataset.i)});
document.getElementById("lbx").addEventListener("click",closeLb);
lb.addEventListener("click",function(e){if(e.target===lb)closeLb()});
document.addEventListener("keydown",function(e){if(e.key==="Escape"&&lb.classList.contains("on"))closeLb()});
// scroll timecode
var tc=document.getElementById("tc");
function pad(n){return(n<10?"0":"")+n}
function upd(){var h=document.documentElement,max=h.scrollHeight-innerHeight,p=max>0?Math.min(1,scrollY/max):0,f=Math.floor(p*180*24);
  tc.textContent="00:"+pad(Math.floor(f/1440))+":"+pad(Math.floor(f/24)%60)+":"+pad(f%24)}
addEventListener("scroll",upd,{passive:true});upd();
</script>
</body>
</html>
